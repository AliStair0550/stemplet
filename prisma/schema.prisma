// Stemplet - digitalt stempelkort. Datamodel.
// Neon Postgres: DATABASE_URL er pooled, DIRECT_URL bruges til migrationer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────
// Virksomhed
// ─────────────────────────────────────────────────────────────

enum Plan {
  FREE
  PRO
}

model Business {
  id               String     @id @default(cuid())
  name             String // firmanavn (login, faktura, konto)
  displayName      String? // navn vist paa kundens kort; tomt = brug name
  // Kortets korte navn i knappen "Hent dit X-kort". Tomt = laves automatisk.
  cardName         String?
  slug             String     @unique
  category         String? // branche (kode), backfilles i indstillinger
  logoUrl          String?
  primaryColor     String     @default("#EFEBE3")
  textColor        String     @default("#1E2633")
  plan             Plan       @default(FREE)
  staffPin         String? // hashet (bcrypt). Null = ingen PIN kraevet ved indloesning (standard; kan slaas til i indstillinger)
  stampCooldownMin Int        @default(15)
  apiKey           String?    @unique // til det offentlige API (Bearer + webhook-signatur)
  webhookUrl       String? // POST'es ved stempel/beloenning/indloesning
  weeklyEmailEnabled Boolean  @default(true) // ugentlig statistik-mail
  // Modtager af ugemailen: en valgt login-mail. NULL = send til alle login-mails.
  weeklyEmailTo      String?
  // Logo-stoerrelse paa kortet: 1 = standard. Ejeren kan skrue op/ned, saa smaa
  // eller kvadratiske logoer kan fylde mere. Gaelder kort, webkort og Wallet-pas.
  logoScale          Float     @default(1)
  // Visitkort-design (skabelon, farver, fonts, hjoerner, kontaktfelter). JSON,
  // saa designeren kan udvikle sig uden en migration pr. felt. Null = ikke
  // designet endnu (bruger brand-standard).
  businessCardDesign Json?
  // Giv et velkomststempel ved kundens ALLERFOERSTE scan (opretter kort + 1
  // stempel). Standard FRA: foerste scan opretter KUN kortet, og stempler gives
  // derefter ved koeb. Saa er strukturen altid den samme: 1. kortet hentes,
  // 2. stempler gives ved kassen. Kan slaaes til i indstillinger.
  welcomeStampEnabled Boolean @default(false)
  // Selvbetjening: maa kunden stemple sig selv ved at scanne en roterende QR
  // (kioskmodus)? Standard FRA: kun personalet scanner kundens kort. Holder
  // butikken enkel (eet statisk tilmeldings-skilt) og loeser snyd strukturelt.
  selfScanEnabled Boolean @default(false)
  // Butikkens placering (valgfri). Saettes kortet paa Wallet-passet som en
  // "location", saa kortet dukker op paa kundens laaseskaerm, naar de er i
  // naerheden. Native Apple Wallet, butikkens bedste paamindelse. Adressen
  // indtastes (man er ikke noedvendigvis paa stedet) og geokodes til lat/lng.
  address          String?
  latitude         Float?
  longitude        Float?
  termsAcceptedAt  DateTime? // accepterede vilkaar/privatliv/DPA ved oprettelse
  // ── Prismodel / manuel fakturering (Billy, ingen Stripe endnu) ──────
  // Kortholder = antal CustomerCard-raekker for butikken (se lib/billing).
  // Fire-once-flag (KENDSGERNING: milepaelen er naaet) vs sent-flag (mailen er
  // bekraeftet leveret). Adskilt, saa et Resend-blip ikke taber varslet: en daglig
  // sweep sender igen for butikker med Warned sat men EmailSent stadig null.
  cardholderWarnedAt DateTime? // varsel om proeveperiodens slutning givet (udloeses kun EEN gang)
  cardholderWarnEmailSentAt DateTime? // varsel-mails bekraeftet leveret
  reached100At       DateTime? // fakturering startet: proeveperioden (3 mdr.) er slut. Gammelt navn fra 100-modellen
  reached100EmailSentAt DateTime? // faktura-trigger-mail til superadmin bekraeftet leveret
  proApprovedAt      DateTime? // ejeren har bekraeftet abonnementet
  proApprovedById    String? // hvilken bruger (User.id) godkendte
  cancelledAt        DateTime? // ejeren har opsagt abonnementet (Ali faar en mail)
  proPriceKr         Int       @default(49) // individuel maanedspris i kr ekskl. moms (founding members mv.)
  proPriceUntil      DateTime? // udloeb for en specialpris; derefter gaelder standard 49
  lastInvoicedAt     DateTime? // sidste faktureringsdato, superadmin vedligeholder manuelt
  newSignupsPaused   Boolean   @default(false) // afvis nye kortholdere paent (kun superadmin)
  stopped            Boolean   @default(false) // superadmin har stoppet butikken (kun superadmin)
  // Henvisninger (modul): slaar henvisningskoder og -beloenninger til for butikken.
  // Standard FRA; uden flaget kan der hverken oprettes eller gennemfoeres henvisninger.
  referralsEnabled   Boolean   @default(false)
  /// Stemplet slaaet til. Fra = kun Henvisninger (Stemplet kan tilfoejes i dashboardet).
  stampsEnabled      Boolean   @default(true)
  /// Kortet: stil paa iOS 27-plakatkortet: "color" | "art" | "photo" | "pattern" | "stamps".
  cardStyle          String    @default("color")
  /// Butikkens eget billede til plakatkortet (data-URI, JPEG, allerede beskaaret).
  cardArtwork        String?
  // Stilen "Motiv": tegnet motiv (aurora, sun, waves, rings, hills, arches) og
  // dets accentfarve (null = automatisk, en tone mellem kortets farver).
  cardArt            String?
  cardAccent         String?
  // Plakaten: eget billede (null = billedet fra Design), de sidste valg, saa
  // man ikke starter forfra, og hvornaar den sidst blev hentet (Kom i gang).
  posterPhoto        String?
  posterSettings     Json?
  posterMadeAt       DateTime?
  // Kom i gang: foerste gang kortet blev delt (link, QR-kode vist eller kopieret).
  sharedAt           DateTime?
  /// Knapper paa kortet (iOS 27, hoejst to): "book" | "henvis" | "beloenninger".
  cardActions        String[]  @default(["fordele"])
  /// Oeverst paa kortet: "logo" (logo, ellers navn), "name" eller "both".
  cardHeader         String    @default("logo")
  // Butikkens eget booking-link (fx Planway), vist som "Book tid" paa
  // henvisningssiden efter tilmelding. Null = knappen skjules.
  bookingUrl         String?
  // Pushbesked fra butikken paa kundernes kort. Ny tekst = notifikation
  // paa laaseskaermen. newsSentAt bruges til hoejst een besked i doegnet.
  newsText           String?
  newsSentAt         DateTime?
  users            User[] // legacy: User.businessId (primaer/oprindelig butik). Adgang styres nu af Membership.
  emailLogs        EmailLog[]
  memberships      Membership[]
  cards            Card[]
  auditLogs        AuditLog[]
  devices          Device[]
  pairingCodes     DevicePairingCode[]
  customerCards    CustomerCard[]
  referralRule     ReferralRule?
  referrals        Referral[]
  rewards          Reward[]
  newsMessages     NewsMessage[]
  memberOffers     MemberOffer[]
  createdAt        DateTime   @default(now())
}

// Historik over sendte pushbeskeder (den aktuelle tekst bor paa Business.newsText).
// recipients = antal kort i Wallet, da beskeden blev sendt.
/// Butikkens egne tilbud og samarbejdspartnere til kortholdere. Vises paa
/// kundens side "Tilbud og fordele". kind: "OFFER" (butikkens tilbud) eller
/// "PARTNER" (rabat hos en samarbejdspartner mod at vise kortet).
model MemberOffer {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  kind        String
  title       String
  text        String?
  partnerName String?
  link        String?
  endsAt      DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@index([businessId, kind])
}

model NewsMessage {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  text       String
  recipients Int
  sentAt     DateTime @default(now())

  @@index([businessId, sentAt])
}

// Medlemskab: hvilke butikker en bruger (mail) har adgang til. Een mail kan
// vaere medlem af FLERE butikker (agentur/flere ejere), og en butik kan have
// flere medlemmer. Kilde til sandhed for adgang; den aktive butik ligger i
// sessionen og kan skiftes uden nyt login.
model Membership {
  id         String   @id @default(cuid())
  userId     String
  businessId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, businessId])
  @@index([userId])
  @@index([businessId])
}

// ─────────────────────────────────────────────────────────────
// Kasse-enhed: en parret disk-enhed (fx iPad) med langtids-adgang til
// registeret UDEN ejer-login. Kan spaerres af ejeren. Adgangen er begraenset
// til kassen (vis QR, scan, stempel, indloes med PIN, kassemodus), aldrig
// dashboard/priser/fakturering.
// ─────────────────────────────────────────────────────────────
model Device {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String    @default("Kasse")
  tokenHash    String    @unique // sha256 af enheds-token (cookie)
  lastSeenAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  stampsGiven  Stamp[]   @relation("DeviceStamps")
  referralVisits Referral[] @relation("ReferralVisitDevice")
  rewardRedemptions Reward[] @relation("RewardRedeemDevice")

  @@index([businessId])
}

// Kortvarig parringskode: ejeren genererer den, personalet indtaster den paa
// enheden. Engangsbrug, udloeber efter faa minutter.
model DevicePairingCode {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  codeHash   String    @unique // sha256 af koden
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([businessId])
}

// ─────────────────────────────────────────────────────────────
// Bruger (kun virksomheder logger ind, aldrig kunder)
// Auth.js-felterne (name, emailVerified, image, accounts, sessions)
// er tilfoejet for magic link via Resend.
// ─────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified DateTime?
  image         String?
  businessId    String // legacy/primaer butik; adgang styres nu af Membership
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  memberships   Membership[]
  accounts      Account[]
  sessions      Session[]
  stampsGiven   Stamp[]   @relation("StaffStamps")
  referralVisits Referral[] @relation("ReferralVisitUser")
  rewardRedemptions Reward[] @relation("RewardRedeemUser")

  @@index([businessId])
}

// Auth.js standardmodeller
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────
// Stempelkort (skabelon defineret af virksomheden)
// ─────────────────────────────────────────────────────────────

model Card {
  id             String         @id @default(cuid())
  businessId     String
  business       Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  stampsRequired Int            @default(10) // 4 til 12
  rewardText     String
  stampIcon      String         @default("coffee") // coffee, scissors, croissant, heart, star, custom
  // Valgfri betingelser (fx "Gaelder kun ved koeb af kaffe"). Vises IKKE paa
  // selve kortet, men diskret under "Hent mit stempelkort" paa kundens
  // hente-side. null = ingen betingelser (slaaet fra i design).
  terms          String?
  active         Boolean        @default(true)
  customerCards  CustomerCard[]
  campaigns      Campaign[]
  createdAt      DateTime       @default(now())

  @@index([businessId])
}

// ─────────────────────────────────────────────────────────────
// Kundens eksemplar af et kort
// ─────────────────────────────────────────────────────────────

model CustomerCard {
  id             String               @id @default(cuid())
  cardId         String
  card           Card                 @relation(fields: [cardId], references: [id], onDelete: Cascade)
  serial         String               @unique // bruges i pass og stregkode
  authToken      String               @unique // hemmeligt, til Wallet web service
  deviceId       String? // stemplet_device-cookie: dedup af claim + genfind ved tabt kort-cookie
  stamps         Int                  @default(0)
  completedCount Int                  @default(0)
  // Livstidstaeller: samlet antal stempler kunden NOGENSINDE har optjent hos
  // butikken. Kortet (stamps) nulstilles ved fuldt kort, men denne goer aldrig.
  // Taelles atomisk op ved hver stempling; backfilles fra sum(Stamp.multiplier).
  // Fundament for milepaele, stamkunde-status og win-back senere.
  lifetimeStamps Int                  @default(0)
  // Kunden har slaaet butikkens pushbeskeder fra (link paa kortets bagside).
  // Kortet faar saa ikke beskedfeltet, og dermed ingen notifikationer.
  newsOptOut     Boolean              @default(false)
  contactEmail   String? // kundens e-mail (normaliseret: trimmet, smaa bogstaver)
  // Udtrykkeligt samtykke til nyheder og tilbud paa mail fra butikken (frivilligt
  // flueben ved oprettelse). Null = intet samtykke. Tidspunktet er dokumentationen.
  marketingConsentAt DateTime?
  recoveryTokens   CardRecoveryToken[]
  // ── Henvisninger ──────────────────────────────────────────────
  // Denormaliseret butik, saa henvisningskoden kan vaere unik PR. BUTIK i
  // databasen (kortet kender ellers kun sin skabelon). Backfillet fra Card i
  // migrationen; saettes af henvisningsmodulet, naar kortet faar en kode.
  businessId       String?
  business         Business?      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Kundens navn og mobil (valgfri). Navnet giver henvisningskoden (SARA-K8),
  // mobilen (normaliseret, fx +4512345678) bruges mod selvhenvisning.
  name             String?
  phone            String?
  // Kundens personlige henvisningskode, fx SARA-K8. Unik pr. butik.
  referralCode     String?
  // Hvem der henviste kunden. Saettes een gang: det foerste link vinder.
  referredByCardId String?
  referredBy       CustomerCard?  @relation("ReferredBy", fields: [referredByCardId], references: [id], onDelete: SetNull)
  referredCards    CustomerCard[] @relation("ReferredBy")
  referralsMade    Referral[]     @relation("ReferralReferrer")
  referralReceived Referral?      @relation("ReferralReferred")
  rewards          Reward[]
  stampsLog      Stamp[]
  redemptions    Redemption[]
  walletRegs     WalletRegistration[]
  createdAt      DateTime             @default(now())
  lastStampAt    DateTime?
  // Kassens idempotency key for seneste fortryd (R10): et gentaget tryk fjerner
  // ikke et stempel mere.
  lastUndoKey    String?
  // Sidst kortets Wallet-pass blev aendret. Saettes ved hvert push (pushWalletUpdate),
  // saa enheden kun henter de kort, der faktisk er aendret (passesUpdatedSince).
  passUpdatedAt  DateTime             @default(now())
  // Sidst et push naaede alle kortets enheder (B4). Er kortet aendret senere
  // (passUpdatedAt > passPushedAt), gik pushet tabt, og den daglige cron sender igen.
  passPushedAt   DateTime?

  @@unique([cardId, deviceId]) // een enhed = eet kort pr. butik (race-sikker dedup)
  @@index([cardId])
  // Statistik scoper alt paa cardId og filtrerer paa tid/livstid. Uden disse
  // scanner hver count/aggregate alle butikkens kortholder-raekker. Daekker
  // tilmeldinger over tid, aktive kunder (lastStampAt) og stamkunde-niveauer.
  @@index([cardId, createdAt])
  @@index([cardId, lastStampAt])
  @@index([cardId, lifetimeStamps])
  @@unique([businessId, referralCode])
  @@index([referredByCardId])
  // Eet mobilnummer = eet kort pr. butik (henvisningssiden). NULL er distinkt.
  @@unique([businessId, phone])
  // Een e-mail = eet kort pr. butik. NULL er distinkt.
  @@unique([businessId, contactEmail])
}

enum StampMethod {
  KIOSK_QR
  STAFF_SCAN
  MANUAL
}

model Stamp {
  id             String       @id @default(cuid())
  customerCardId String
  customerCard   CustomerCard @relation(fields: [customerCardId], references: [id], onDelete: Cascade)
  // Denormaliseret butik: transaktionsloggen skal kunne svare paa "hvilken butik"
  // uden at joine gennem card. Billigt nu, dyrt at eftermontere. Backfilles.
  businessId     String?
  method         StampMethod
  tokenJti       String?
  multiplier     Int          @default(1)
  // Medarbejder-attribution: hvem gav stemplet. Kassen er enten en parret ENHED
  // eller ejerens LOGIN, saa vi logger begge (den relevante er sat). Vigtigt til
  // anti-snyd (opdage en medarbejder der stempler venner) og senere statistik.
  // NULL for kunde-QR og API-stempler samt historik foer attribution fandtes.
  staffUserId    String?
  staffUser      User?        @relation("StaffStamps", fields: [staffUserId], references: [id], onDelete: SetNull)
  staffDeviceId  String?
  staffDevice    Device?      @relation("DeviceStamps", fields: [staffDeviceId], references: [id], onDelete: SetNull)
  // Livstidstal EFTER denne transaktion (loebende sum). Lader os finde praecis
  // hvornaar en milepael (50/100/250) blev naaet uden omberegning. Billigt nu,
  // dyrt at eftermontere. Backfilles som running sum.
  lifetimeAfter  Int?
  // Udloeste denne stempling et fuldt kort? Billigt at logge nu, dyrt at udlede
  // bagud. Historik: false (kan ikke rekonstrueres praecist).
  filledCard     Boolean      @default(false)
  idempotencyKey String?
  createdAt      DateTime     @default(now())

  // Et token maa bruges een gang PR. KORT. NULL-jti'er (personale/API) kolliderer
  // aldrig, da NULL regnes som distinkt i Postgres.
  @@unique([tokenJti, customerCardId])
  // Kassens idempotency key (R10): samme tryk giver aldrig to stempler, heller
  // ikke naar Redis er nede. NULL (kunde-QR, API) kolliderer aldrig.
  @@unique([customerCardId, idempotencyKey])
  @@index([customerCardId])
  // Tids-vinduer i statistik (i dag/uge/14 dage) + ugebrev-cron: dette indeks
  // daekker baade relations-semi-joinet og createdAt-range i eet scan.
  @@index([customerCardId, createdAt])
  // Per-butik-analyser (milepaele, win-back, medarbejder-moenstre) over tid.
  @@index([businessId, createdAt])
}

model Redemption {
  id             String       @id @default(cuid())
  customerCardId String
  customerCard   CustomerCard @relation(fields: [customerCardId], references: [id], onDelete: Cascade)
  // Kassens idempotency key (R10): samme tryk indloeser aldrig to gange.
  idempotencyKey String?
  createdAt      DateTime     @default(now())

  @@unique([customerCardId, idempotencyKey])
  @@index([customerCardId])
  // Tids-vinduer (indloesninger seneste 30 dage) + avgDaysToFull-window-query.
  @@index([customerCardId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Henvisninger (se docs/henvisninger.md, Datamodel)
// ─────────────────────────────────────────────────────────────

enum ReferralStatus {
  CREATED // aaben henvisning: den nye kunde har hentet kortet via kode/link
  VISITED // foerste besoeg bekraeftet ved kassen (mellemtilstand, se lib/referral)
  REWARDED // beloenninger oprettet
  EXPIRED // aldrig gennemfoert inden reward_expiry_days
  VOIDED // annulleret af butikken
}

enum ReferralSource {
  LINK
  CODE_ENTERED
  MANUAL_AT_DESK
}

enum RewardType {
  AMOUNT // value = kroner, fx "100"
  PERCENT // value = procent rabat, fx "20"
  STAMPS // value = antal stempler, fx "3"
  SERVICE // value = fri tekst, fx "Gratis klip"
}

enum RewardStatus {
  AVAILABLE
  REDEEMED
  EXPIRED
}

// Butikkens henvisningsregler. Een pr. butik; uden regel kan en henvisning ikke
// gennemfoeres (der er intet at beloenne med).
model ReferralRule {
  id                     String     @id @default(cuid())
  businessId             String     @unique
  business               Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  newCustomerRewardType  RewardType
  newCustomerRewardValue String
  referrerRewardType     RewardType
  referrerRewardValue    String
  minPurchaseKr          Int? // vises i betingelserne; haandhaeves af personalet ved disken
  maxReferralsPerMonth   Int? // pr. henviser, kalendermaaned (dansk tid). Null = intet loft
  rewardExpiryDays       Int        @default(180)
  termsLine              String?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
}

// Een henvisning: kobler henviseren (ambassadoeren) til den nye kunde. Et kort
// kan kun vaere henvist een gang (referredCardId er unik): det foerste vinder.
model Referral {
  id                     String         @id @default(cuid())
  businessId             String
  business               Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // SetNull (ikke Cascade): slettes henviserens kort, bliver henvisningen
  // liggende uden henviser, saa vennen stadig staar som henvist og ikke kan faa
  // velkomstrabatten igen. Ingen data om den slettede kunde gemmes.
  referrerCardId         String?
  referrerCard           CustomerCard?  @relation("ReferralReferrer", fields: [referrerCardId], references: [id], onDelete: SetNull)
  referredCardId         String         @unique
  referredCard           CustomerCard   @relation("ReferralReferred", fields: [referredCardId], references: [id], onDelete: Cascade)
  status                 ReferralStatus @default(CREATED)
  source                 ReferralSource
  createdAt              DateTime       @default(now())
  visitedAt              DateTime?
  rewardedAt             DateTime?
  // Hvem trykkede "Foerste besoeg gennemfoert". Kassen er enten ejer-login eller
  // en parret enhed (samme attribution som Stamp), saa begge kan logges.
  visitedByStaffUserId   String?
  visitedByStaffUser     User?          @relation("ReferralVisitUser", fields: [visitedByStaffUserId], references: [id], onDelete: SetNull)
  visitedByStaffDeviceId String?
  visitedByStaffDevice   Device?        @relation("ReferralVisitDevice", fields: [visitedByStaffDeviceId], references: [id], onDelete: SetNull)
  // Idempotency key fra kassens tryk. Gemmes i databasen (ikke kun Redis), saa
  // et gentaget tryk med samme noegle altid giver samme svar, ogsaa uden Redis.
  visitIdempotencyKey    String?
  rewards                Reward[]

  @@index([businessId, status])
  @@index([referrerCardId])
  // Loftet: henviserens gennemfoerte henvisninger i en maaned.
  @@index([referrerCardId, status, rewardedAt])
}

// En optjent beloenning (baade til henviser og ny kunde).
model Reward {
  id         String       @id @default(cuid())
  businessId String
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  cardId     String
  card       CustomerCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  // SetNull: sletter den nye kunde sit kort, beholder henviseren sin beloenning.
  referralId String?
  referral   Referral?    @relation(fields: [referralId], references: [id], onDelete: SetNull)
  type       RewardType
  value      String
  status     RewardStatus @default(AVAILABLE)
  expiresAt  DateTime
  redeemedAt DateTime?
  // Hvem trykkede "Beloenning indloest" (ejer-login eller parret enhed), og
  // kassens idempotency key, saa et gentaget tryk giver samme svar uden Redis.
  redeemedByStaffUserId   String?
  redeemedByStaffUser     User?   @relation("RewardRedeemUser", fields: [redeemedByStaffUserId], references: [id], onDelete: SetNull)
  redeemedByStaffDeviceId String?
  redeemedByStaffDevice   Device? @relation("RewardRedeemDevice", fields: [redeemedByStaffDeviceId], references: [id], onDelete: SetNull)
  redeemIdempotencyKey    String?
  createdAt  DateTime     @default(now())

  @@index([cardId, status])
  @@index([referralId])
  // Daglig udloebs-sweep: status = AVAILABLE og expiresAt < nu.
  @@index([status, expiresAt])
}

enum CampaignType {
  DOUBLE_STAMP
  WELCOME_BONUS
  // Stempel ved afhentning: en kunde der henter kortet i perioden faar 1 stempel
  // med det samme. "Hent inden en dato" = kampagnens slutdato.
  PICKUP_STAMP
}

model Campaign {
  id       String       @id @default(cuid())
  cardId   String
  card     Card         @relation(fields: [cardId], references: [id], onDelete: Cascade)
  type     CampaignType
  startsAt DateTime
  endsAt   DateTime

  @@index([cardId])
}

model WalletRegistration {
  id              String       @id @default(cuid())
  customerCardId  String
  customerCard    CustomerCard @relation(fields: [customerCardId], references: [id], onDelete: Cascade)
  deviceLibraryId String
  pushToken       String

  @@unique([customerCardId, deviceLibraryId])
  @@index([customerCardId])
  // Apple poller enheds-endpointet pr. enhed og filtrerer paa deviceLibraryId
  // alene. Uden dette indeks faldt det opslag tilbage til fuld scan (unique'ens
  // foerste kolonne er customerCardId), som vokser med antallet af registreringer.
  @@index([deviceLibraryId])
}

// ─────────────────────────────────────────────────────────────
// "Hold mig orienteret"-tilmelding (marketing/nyhedsbrev-forberedt)
// Dobbelt opt-in: raekken oprettes ved tilmelding (confirmedAt = null), og
// samtykket er foerst aktivt, naar bekraeftelseslinket er klikket (confirmedAt
// sat + IP gemt som dokumentation). email er unik, saa gentilmelding opdaterer
// samme raekke i stedet for at lave dubletter.
// ─────────────────────────────────────────────────────────────

enum MarketingStatus {
  NEW // Ny (ikke behandlet)
  CONTACTED // Kontaktet
  NOT_RELEVANT // Ikke relevant
}

model MarketingSignup {
  id           String          @id @default(cuid())
  name         String? // valgfrit (footer-varianten har kun mail)
  storeName    String? // butiksnavn, valgfrit
  phone        String? // mobil (normaliseret), fra "Hør mere", saa vi kan ringe
  email        String          @unique
  source       String // "forside", branche-slug (fx /stempelkort-til-kaffebarer) eller "footer"
  status       MarketingStatus @default(NEW) // saettes manuelt i admin
  note         String? // frit notefelt pr. tilmelding (admin)
  signedUpAt   DateTime        @default(now()) // tidsstempel for tilmelding
  confirmedAt  DateTime? // tidsstempel for bekraeftelse (dobbelt opt-in)
  confirmIp    String? // IP ved bekraeftelse (samtykkedokumentation)

  // Nyeste oeverst i admin; kilde-fordeling og "bekraeftede/nye" i tællekortene.
  @@index([signedUpAt])
  @@index([confirmedAt])
  @@index([source])
}

model AuditLog {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  action     String // STAMP, REDEEM, PIN_FAIL, FLAGGED
  detail     Json
  ip         String?
  createdAt  DateTime @default(now())

  @@index([businessId])
  @@index([businessId, action])
  // "Seneste aktivitet": where businessId order by createdAt desc take N.
  @@index([businessId, createdAt])
}

// DB-backet rate limit til magic-link-afsendelse (fail-closed), saa email-
// bombning ogsaa er bremset hvis Redis falder. scope = "login-email" osv.
model SendThrottle {
  id          String   @id @default(cuid())
  scope       String
  key         String
  count       Int      @default(0)
  windowStart DateTime @default(now())

  @@unique([scope, key])
}

// Personale-PIN forsoeg/laasning. DB-backet (ikke kun Redis), saa laasningen
// aldrig kan omgaas ved et Redis-nedbrud. lockId er IP (eller enheds-id).
model PinAttempt {
  id          String    @id @default(cuid())
  businessId  String
  lockId      String
  fails       Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([businessId, lockId])
}

// Gendan kortet med e-mail: kunden faar et link paa mail, der virker een gang og
// i kort tid. Kun hashen gemmes, saa en databaselaesning ikke giver brugbare links.
model CardRecoveryToken {
  id             String       @id @default(cuid())
  tokenHash      String       @unique
  customerCardId String
  customerCard   CustomerCard @relation(fields: [customerCardId], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([customerCardId])
}

// Mails til ejere og superadmin, der kun maa sendes een gang pr. modtager (R17):
// varsel om proeveperiode, faktura-start og ugemail. Raekken skrives FOER mailen
// sendes, saa to samtidige koersler ikke begge sender. sentAt = bekraeftet sendt;
// null = i gang (eller en koersel, der doede midt i og maa tages igen).
model EmailLog {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  kind       String // fx "trial-warn", "invoice", "weekly:2026-11-02"
  recipient  String
  sentAt     DateTime?
  createdAt  DateTime  @default(now())

  @@unique([businessId, kind, recipient])
}
